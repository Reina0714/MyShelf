<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PrimaryButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:background">@color/primary_green</item>
        <item name="android:textColor">@color/card_background</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TitleTextStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/text_black</item>
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="StatusTagStyle" parent="Widget.AppCompat.TextView">
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">@dimen/text_size_status</item>
        <item name="android:textColor">@color/card_background</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
</resources>
<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_standard"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_standard">

        <ImageView
            android:id="@+id/iv_item_icon"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:src="@drawable/ic_home" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/iv_item_icon">

            <TextView
                android:id="@+id/tv_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Whole Milk"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_body"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_item_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_item_name"
                android:text="1 Remaining"
                android:textColor="@color/text_light_grey"
                android:textSize="@dimen/text_size_status" />

            <TextView
                android:id="@+id/tv_expiry_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_item_description"
                android:layout_marginTop="2dp"
                android:text="Exp: 2 days"
                android:textColor="#FF9800"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_status" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_item_status"
                style="@style/StatusTagStyle"
                android:background="@drawable/background_yellow"
                android:text="USE SOON" />

            <TextView
                android:id="@+id/tv_item_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="RM 4.00"
                android:textColor="@color/text_dark_grey"
                android:textSize="@dimen/text_size_status" />

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>